# Banco SQLite local (single-user; caminho relativo à raiz do projeto)
DATABASE_URL=./data/sale-track.db

# Teto de faturamento MEI em centavos (default R$ 81.000,00 => 8100000)
MEI_LIMIT_CENTS=8100000

# Percentual padrão de taxa por canal (decimal, ex.: 0.12 = 12%)
# Usado apenas para pré-preencher a taxa na venda — nunca é fonte de verdade do caixa.
FEE_RATE_SHOPEE=0.12
FEE_RATE_TIKTOK=0.20
